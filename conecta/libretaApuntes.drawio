        <mxCell id="USlgTkdP3ek-1mb_6Dk--53" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SNS&lt;/h1&gt;&lt;p&gt;Simple notification service.&lt;/p&gt;&lt;p&gt;Para los webhook que debemos de crear, debemos de evaluar el uso de SNS en ves de Lambda&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="972" y="2409" as="geometry" />
        </mxCell>
        <mxCell id="USlgTkdP3ek-1mb_6Dk--57" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Miguel:&amp;nbsp;agregar al documento de análisis inicial el requerimiento para generar archivo diario de disputas y Request para enviar esta información al HUB&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Parafraseando:&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;Adicionar en los procesos batch, un proceso para el generación de archivo diario de disputa.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Y ese mismo proceso se conecta a un end-point del HUB en el que tengo que enviar el archivo. Esto es un supuesto, no estamos claro de como será enviada la información.&lt;/div&gt;" vertex="1">
          <mxGeometry height="106" width="601" x="63" y="3197" as="geometry" />
        </mxCell>
        <mxCell id="USlgTkdP3ek-1mb_6Dk--58" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Sistema / Algo / Whatever&lt;/div&gt;&lt;div&gt;Suspuesto: Montran&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; │&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ▼&lt;/div&gt;&lt;div&gt;Tabla&lt;/div&gt;&lt;div&gt;Siguiendo el supuesto: esta sería una tabla de Montan&lt;/div&gt;&lt;div&gt;Creariamos un sistema que se comunique con Autopista&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;, para enviar los registros de tabla de Disputa&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Es decir, vamos hacer un proceso de subida a AWS&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; │&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ▼&lt;/div&gt;&lt;div&gt;API Rest / end-point / recibe la disputa&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; │&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ▼&lt;/div&gt;&lt;div&gt;Tabla de DynamoDB&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; │&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ▼&lt;/div&gt;&lt;div&gt;Crea el registros de disputa (Definir los filtros)&lt;/div&gt;&lt;div&gt;BANCO_ORIGINA_DISPUTA|TIPO_DISPUTA|BANCO_DESTINO_DISPUTA|DETALLE_DISPUTA&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; │&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ▼&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;Endpoint HUB&lt;/div&gt;" vertex="1">
          <mxGeometry height="363" width="601" x="63" y="3315" as="geometry" />
        </mxCell>
        <mxCell id="USlgTkdP3ek-1mb_6Dk--59" edge="1" parent="1" source="USlgTkdP3ek-1mb_6Dk--60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="USlgTkdP3ek-1mb_6Dk--62">
