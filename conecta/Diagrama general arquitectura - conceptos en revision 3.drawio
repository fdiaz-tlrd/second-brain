  <diagram name="modelo interoperable 2" id="J-WXV05euksHiW76vHT5">
    <mxGraphModel dx="2802" dy="1467" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="Hbr0IoWbXT5AyZoAjcEU-0" />
        <mxCell id="Hbr0IoWbXT5AyZoAjcEU-1" parent="Hbr0IoWbXT5AyZoAjcEU-0" />
        <mxCell id="Hbr0IoWbXT5AyZoAjcEU-7" parent="Hbr0IoWbXT5AyZoAjcEU-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;" value="&lt;div style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;li&gt;&lt;p&gt;&lt;strong&gt;Interoperabilidad con terceros&lt;/strong&gt;&lt;br&gt;¿ACH Xpress contempla mecanismos de integración con plataformas o procesadores externos que administren conexiones con entidades financieras, independientemente de si dichas entidades forman parte directa del ecosistema de ACH Xpress?&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;strong&gt;Parametrización de reglas de compensación&lt;/strong&gt;&lt;br&gt;¿La solución permite definir criterios, parámetros o identificadores que habiliten el tratamiento diferenciado de ciertas transacciones dentro del proceso de compensación?&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;strong&gt;Carga de transacciones provenientes de canales externos&lt;/strong&gt;&lt;br&gt;¿ACH Xpress permite la incorporación de archivos o lotes de transacciones originadas o gestionadas fuera de la plataforma, para efectos de validación, registro, conciliación o procesamiento posterior?&lt;/p&gt;&lt;/li&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="810" x="60" y="900" as="geometry" />
        </mxCell>
